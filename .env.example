# Variables Compose — copiez ce fichier vers .env puis remplacez chaque placeholder.
# Ne committez jamais .env et utilisez des valeurs aléatoires générées hors dépôt.
POSTGRES_DB=autocommerce_clinic
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM
TZ=Africa/Tunis
PUBLIC_API_URL=/api/private
CELERY_WORKER_CONCURRENCY=2
# Le reverse proxy hôte et les ports Compose restent liés à 127.0.0.1.
# Les sorties externes sont réglées dans api-server/.env.clinic.
# Variables du script de backup hôte (dans /etc/autocommerce/.env.production).
BACKUP_ROOT=/mnt/autocommerce-backups
BACKUP_REQUIRE_SEPARATE_DEVICE=1
